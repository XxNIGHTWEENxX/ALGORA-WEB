<style>
:root{
  --bg:#0A0A0A; --bg2:#121212; --card:#161616; --line:#262626;
  --tx:#FFFFFF; --tx2:#A3A3A3; --tx3:#666; --accent:#FFFFFF;
}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{font-family:'Inter',system-ui,sans-serif;background:var(--bg);color:var(--tx);line-height:1.5;-webkit-font-smoothing:antialiased;overflow-x:hidden}
a{color:inherit;text-decoration:none}
.wrap{max-width:1180px;margin:0 auto;padding:0 24px}
.btn{display:inline-flex;align-items:center;gap:8px;height:48px;padding:0 26px;border-radius:12px;font-weight:700;font-size:15px;transition:.2s;cursor:pointer;border:none}
.btn-pri{background:#fff;color:#0A0A0A}
.btn-pri:hover{transform:translateY(-2px);box-shadow:0 12px 30px rgba(255,255,255,.15)}
.btn-sec{background:transparent;color:#fff;border:1px solid var(--line)}
.btn-sec:hover{border-color:#fff}
.tag{display:inline-block;font-size:12px;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;color:var(--tx2);padding:6px 14px;border:1px solid var(--line);border-radius:100px;margin-bottom:20px}

/* NAV */
nav{position:sticky;top:0;z-index:50;background:rgba(10,10,10,.8);backdrop-filter:blur(16px);border-bottom:1px solid var(--line)}
.nav{display:flex;align-items:center;justify-content:space-between;height:68px}
.logo{display:flex;align-items:center;gap:10px;font-weight:900;font-size:20px;letter-spacing:2px}
.logo svg{width:30px;height:30px}
.logo-img{height:30px;width:auto}
.logo-img.lg{height:34px}
.nav-links{display:flex;gap:32px;font-size:14px;font-weight:500;color:var(--tx2)}
.nav-links a:hover{color:#fff}
@media(max-width:860px){.nav-links{display:none}}

/* HERO */
.hero{position:relative;padding:90px 0 70px;text-align:center;overflow:hidden}
.hero::before{content:'';position:absolute;top:-30%;left:50%;transform:translateX(-50%);width:900px;height:700px;background:radial-gradient(circle,rgba(255,255,255,.07),transparent 65%);pointer-events:none}
.hero h1{font-size:clamp(38px,6.5vw,72px);font-weight:900;line-height:1.04;letter-spacing:-2px;max-width:900px;margin:0 auto 22px;position:relative}
.hero h1 .muted{color:var(--tx3)}
.hero p.sub{font-size:clamp(17px,2.2vw,21px);color:var(--tx2);max-width:620px;margin:0 auto 36px;position:relative}
.hero-cta{display:flex;gap:14px;justify-content:center;flex-wrap:wrap;position:relative}
.hero-note{margin-top:18px;font-size:13px;color:var(--tx3);position:relative}

/* REPLACES STRIP */
.replaces{padding:46px 0;border-top:1px solid var(--line);border-bottom:1px solid var(--line);background:var(--bg2)}
.replaces .lbl{text-align:center;font-size:13px;color:var(--tx3);font-weight:600;letter-spacing:1px;text-transform:uppercase;margin-bottom:22px}
.replaces .row{display:flex;flex-wrap:wrap;justify-content:center;gap:14px 36px}
.replaces .row span{font-size:clamp(16px,2.4vw,22px);font-weight:700;color:var(--tx2);opacity:.75}
.replaces .row span.strike{text-decoration:line-through;text-decoration-color:#555}

/* SECTION */
section.pad{padding:90px 0}
.head{text-align:center;max-width:680px;margin:0 auto 56px}
.head h2{font-size:clamp(30px,4.5vw,46px);font-weight:800;letter-spacing:-1px;line-height:1.1;margin-bottom:16px}
.head p{font-size:18px;color:var(--tx2)}

/* MODULES GRID */
.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
@media(max-width:900px){.grid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:600px){.grid{grid-template-columns:1fr}}
.mod{background:var(--card);border:1px solid var(--line);border-radius:18px;padding:28px;transition:.25s}
.mod:hover{border-color:#3a3a3a;transform:translateY(-4px);background:#1a1a1a}
.mod .ic{width:46px;height:46px;border-radius:12px;background:#fff;display:flex;align-items:center;justify-content:center;margin-bottom:18px}
.mod .ic svg{width:24px;height:24px;stroke:#0A0A0A}
.mod h3{font-size:18px;font-weight:700;margin-bottom:8px}
.mod p{font-size:14.5px;color:var(--tx2);line-height:1.55}

/* FEATURE ROWS */
.feat{display:grid;grid-template-columns:1fr 1fr;gap:50px;align-items:center;margin-bottom:90px}
.feat:nth-child(even) .fimg{order:-1}
@media(max-width:820px){.feat{grid-template-columns:1fr;gap:28px;margin-bottom:60px}.feat:nth-child(even) .fimg{order:0}}
.feat .ftag{font-size:13px;font-weight:700;color:var(--tx3);letter-spacing:1px;text-transform:uppercase;margin-bottom:14px}
.feat h3{font-size:clamp(24px,3.5vw,34px);font-weight:800;letter-spacing:-.5px;line-height:1.15;margin-bottom:16px}
.feat p{font-size:16.5px;color:var(--tx2);margin-bottom:18px}
.feat ul{list-style:none;display:flex;flex-direction:column;gap:11px}
.feat ul li{display:flex;gap:11px;font-size:15px;color:#d4d4d4}
.feat ul li svg{width:20px;height:20px;flex-shrink:0;stroke:#fff;margin-top:1px}
.fimg{background:linear-gradient(145deg,#1c1c1c,#101010);border:1px solid var(--line);border-radius:20px;aspect-ratio:4/3;display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden}
.fimg .big{font-size:clamp(40px,8vw,90px);font-weight:900;color:#fff;opacity:.07;letter-spacing:-3px;text-align:center;padding:20px;line-height:1}

/* PRICING */
.pricing{background:var(--bg2);border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
.plans{display:grid;grid-template-columns:repeat(5,1fr);gap:14px;align-items:stretch}
@media(max-width:1100px){.plans{grid-template-columns:repeat(3,1fr)}}
@media(max-width:920px){.plans{grid-template-columns:repeat(2,1fr)}}
@media(max-width:540px){.plans{grid-template-columns:1fr}}
.plan{background:var(--card);border:1px solid var(--line);border-radius:18px;padding:26px;display:flex;flex-direction:column}
.plan.feat-plan{border-color:#fff;box-shadow:0 0 0 1px #fff}
.plan .pname{font-size:14px;font-weight:700;color:var(--tx2);text-transform:uppercase;letter-spacing:1px;margin-bottom:14px}
.plan .price{font-size:38px;font-weight:900;letter-spacing:-1px;line-height:1}
.plan .price small{font-size:15px;font-weight:600;color:var(--tx3)}
.plan .pyear{font-size:13px;color:var(--tx3);margin-top:6px}
.plan .pdesc{font-size:14px;color:var(--tx2);margin:16px 0;flex:1}
.plan .badge{display:inline-block;background:#fff;color:#0A0A0A;font-size:11px;font-weight:800;padding:4px 10px;border-radius:100px;text-transform:uppercase;letter-spacing:.5px;margin-bottom:14px;align-self:flex-start}
.plan .btn{width:100%;justify-content:center;height:44px}
.pnote{text-align:center;color:var(--tx3);font-size:14px;margin-top:30px}
.cmp-wrap{margin-top:48px;overflow-x:auto}
.cmp{width:100%;border-collapse:collapse;min-width:680px;font-size:14.5px}
.cmp th,.cmp td{padding:14px 16px;text-align:center;border-bottom:1px solid var(--line)}
.cmp th:first-child,.cmp td:first-child{text-align:left;color:var(--tx2);font-weight:500}
.cmp thead th{font-size:13px;font-weight:800;color:#fff;border-bottom:1px solid #333}
.cmp thead th span{display:block;font-size:12px;font-weight:600;color:var(--tx3);margin-top:3px}
.cmp thead th.hl{position:relative}
.cmp thead th.hl::after{content:'POPULAR';position:absolute;top:-9px;left:50%;transform:translateX(-50%);background:#fff;color:#0A0A0A;font-size:9px;font-weight:800;padding:2px 8px;border-radius:100px;letter-spacing:.5px}
.cmp td.yes{color:#fff}
.cmp td.no{color:#3a3a3a}
.cmp .ic{width:18px;height:18px;display:inline-block;vertical-align:middle}
.cmp tbody tr:hover{background:#141414}
.cmp .grp td{background:#121212;font-weight:700;color:#fff;text-align:left;font-size:12px;text-transform:uppercase;letter-spacing:1px}
.cmp col.hl-col{background:rgba(255,255,255,.03)}

/* DIFERENCIADORES strip */
.why{display:grid;grid-template-columns:repeat(4,1fr);gap:30px;text-align:center}
@media(max-width:780px){.why{grid-template-columns:repeat(2,1fr);gap:36px}}
.why .n{font-size:40px;font-weight:900;letter-spacing:-1px;margin-bottom:8px}
.why .t{font-size:15px;color:var(--tx2)}

/* ADD-ONS por giro */
.addons{display:grid;grid-template-columns:repeat(2,1fr);gap:18px}
@media(max-width:820px){.addons{grid-template-columns:1fr}}
.addon{background:var(--card);border:1px solid var(--line);border-radius:20px;padding:30px;display:flex;flex-direction:column;transition:.25s}
.addon:hover{border-color:#3a3a3a;transform:translateY(-4px)}
.addon .atop{display:flex;align-items:center;gap:14px;margin-bottom:8px}
.addon .ic{width:46px;height:46px;border-radius:12px;background:#fff;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.addon .ic svg{width:24px;height:24px;stroke:#0A0A0A}
.addon h3{font-size:21px;font-weight:800;letter-spacing:-.3px}
.addon .akick{font-size:12px;font-weight:700;letter-spacing:1px;text-transform:uppercase;color:var(--tx3)}
.addon>p{font-size:15px;color:var(--tx2);margin:6px 0 18px;line-height:1.55}
.addon ul{list-style:none;display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:22px}
@media(max-width:480px){.addon ul{grid-template-columns:1fr}}
.addon ul li{display:flex;gap:9px;font-size:14px;color:#d4d4d4}
.addon ul li svg{width:18px;height:18px;flex-shrink:0;stroke:#fff;margin-top:1px}
.addon .afoot{margin-top:auto;display:flex;align-items:center;justify-content:space-between;gap:14px;flex-wrap:wrap;border-top:1px solid var(--line);padding-top:18px}
.addon .aprice{font-size:26px;font-weight:900;letter-spacing:-1px}
.addon .aprice small{font-size:13px;font-weight:600;color:var(--tx3)}
.addon .aprice .free{display:block;font-size:12px;font-weight:600;color:var(--tx3);letter-spacing:0}

/* GIROS */
.giros{display:flex;flex-wrap:wrap;justify-content:center;gap:12px;max-width:760px;margin:0 auto}
.giros span{background:var(--card);border:1px solid var(--line);border-radius:100px;padding:10px 20px;font-size:14.5px;font-weight:600;color:#d4d4d4}

/* CTA */
.cta{text-align:center;padding:100px 0}
.cta h2{font-size:clamp(32px,5vw,54px);font-weight:900;letter-spacing:-1.5px;line-height:1.08;max-width:760px;margin:0 auto 22px}
.cta p{font-size:18px;color:var(--tx2);margin-bottom:34px}

/* FOOTER */
footer{border-top:1px solid var(--line);padding:50px 0 40px}
.foot{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:20px}
.foot .mission{max-width:440px;font-size:14px;color:var(--tx2);line-height:1.6}
.foot .legal{font-size:13px;color:var(--tx3)}
.wpp{position:fixed;bottom:24px;right:24px;width:58px;height:58px;border-radius:50%;background:#25D366;display:flex;align-items:center;justify-content:center;box-shadow:0 8px 24px rgba(37,211,102,.4);z-index:60;transition:.2s}
.wpp:hover{transform:scale(1.08)}
.wpp svg{width:30px;height:30px;fill:#fff}
.reveal{opacity:0;transform:translateY(24px);transition:.7s cubic-bezier(.16,1,.3,1)}
.reveal.in{opacity:1;transform:none}
</style>
</head>
